<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 查询已安装应用列表 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="io.github.hyperisland.permission.CONTROL_SCREEN_RECORDER" />

    <application
        android:label="HyperDock"
        android:name=".HyperDockApp"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:description="@string/module_description"
        android:icon="@drawable/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/ComposeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".MainActivityAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="HyperDock"
            android:icon="@drawable/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- SystemUI 侧探测到的“本机可用系统磁贴目录”会定向广播到这里。
             exported 必须为 true：发送方是 com.android.systemui（不同 uid）。
             接收到的内容再落库给 Compose 的选择器页面用。 -->
        <receiver
            android:name=".systemtile.SystemTileCatalogReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.z1812.hyperdock.action.SYSTEM_TILE_CATALOG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
